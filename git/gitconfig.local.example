# Machine-specific git identity, signing, and credentials.
# Copied to ~/.gitconfig.local by install.sh (gitignored — never commit real values).
# Included from git/gitconfig, so it can add/override anything there.

[user]
	name = Your Name
	email = you@example.com
	# SSH commit signing (1Password on macOS example):
	# signingkey = /Users/you/.ssh/github_1password.pub

# Enable commit signing only once signingkey + program below are set,
# otherwise every commit will fail on a fresh machine.
# [commit]
# 	gpgsign = true
# [gpg]
# 	format = ssh

# --- 1Password SSH signing (macOS) ---
# [gpg "ssh"]
# 	program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign
# 	allowedSignersFile = ~/.ssh/allowed_signers

# --- 1Password SSH signing (Arch) ---
# [gpg "ssh"]
# 	program = /opt/1Password/op-ssh-sign
# 	allowedSignersFile = ~/.ssh/allowed_signers

# --- Use gh as the GitHub credential helper ---
# [credential "https://github.com"]
# 	helper =
# 	helper = !gh auth git-credential
# [credential "https://gist.github.com"]
# 	helper =
# 	helper = !gh auth git-credential
